---
import { SEO } from '../../components/SEO.astro'; // if you have one; otherwise remove this line+component below

const base = import.meta.env.BASE_URL; // "/" locally, "/Research.github.io/" on GH Pages
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Crystal Viewer</title>

    <!-- Load JSmol from /public exactly; keep is:inline so Vite doesn’t bundle it -->
    <script src={`${base}jsmol/JSmol.min.js`} is:inline></script>

    <style>
      #viewer-wrap { max-width: 900px; margin: 2rem auto; padding: 1rem; }
      #applet { width: 600px; height: 600px; margin: 0 auto; border: 1px solid #ddd; border-radius: 8px; }
      #controls { display:flex; gap:.5rem; justify-content:center; margin-top:1rem; flex-wrap:wrap; }
      button { padding:.5rem .8rem; border:1px solid #ccc; border-radius:8px; cursor:pointer; background:transparent; }
      .error { color:#c62828; text-align:center; font-weight:600; }
      .mono { font-family: ui-monospace, Menlo, Consolas, monospace; font-size:.9rem; background:rgba(127,127,127,.08); padding:.5rem .75rem; border-radius:.5rem; }
      h1, p { text-align:center; }
      details { margin-top:1rem; }
    </style>
  </head>
  <body>
    <main id="viewer-wrap">
      <h1 id="title">Crystal Viewer</h1>
      <div id="applet"></div>
      <div id="controls" hidden>
        <button data-script="spin on">Spin</button>
        <button data-script="spin off">Stop</button>
        <button data-script="zoom 120">Zoom 120%</button>
        <button data-script="zoom 100">Zoom 100%</button>
        <button data-script="spacefill on; wireframe off;">Spacefill</button>
        <button data-script="spacefill off; wireframe 0.15;">Wireframe</button>
        <button data-script="axes on">Axes</button>
        <button data-script="axes off">Axes off</button>
        <button data-script="set antialiasDisplay true">Antialias</button>
      </div>

      <!-- Correct usage hint (clickable) -->
      <p id="hint" class="mono">
        Open with
        <a id="ex" href="#">?cif=/assets/cifs/2055317.cif&title=2055317</a>
      </p>
      <p id="err" class="error" hidden></p>

      <details id="dbg" hidden>
        <summary>Debug</summary>
        <div id="dbgText" class="mono"></div>
      </details>
    </main>

    <script is:inline>
      (async function () {
        const BASE = `${import.meta.env.BASE_URL}`; // "/" dev, "/Research.github.io/" prod

        // Fill the example link with the proper base at runtime
        const ex = document.getElementById('ex');
        ex.href = location.pathname + '?cif=/assets/cifs/2055317.cif&title=2055317';

        const qs = new URLSearchParams(location.search);
        const cifParam = qs.get('cif');   // e.g. /assets/cifs/2055317.cif
        const title    = qs.get('title') || 'Crystal Viewer';

        const elTitle = document.getElementById('title');
        const elErr   = document.getElementById('err');
        const elHint  = document.getElementById('hint');
        const elDbg   = document.getElementById('dbg');
        const elDbgText = document.getElementById('dbgText');

        elTitle.textContent = title;

        function showErr(msg, extra) {
          elErr.textContent = msg;
          elErr.hidden = false;
          elDbg.hidden = false;
          if (extra) { elDbgText.textContent = JSON.stringify(extra, null, 2); }
          console.error('[JSmol Viewer]', msg, extra || '');
        }

        // No CIF param? just show the hint.
        if (!cifParam) return;

        // Build CIF URL respecting the GitHub Pages base
        const cifUrl = cifParam.startsWith('/')
          ? (BASE.replace(/\/$/, '') + cifParam)
          : (BASE + cifParam);

        // Quick existence checks (so failures are obvious)
        const j2sPath = BASE + 'jsmol/j2s';
        try {
          const probe = j2sPath + '/core/core.z.js';
          const r = await fetch(probe, { cache: 'no-store' });
          if (!r.ok) throw new Error('j2s core not found at ' + probe);
        } catch (e) {
          showErr('JSmol j2s files not found.', { expected: j2sPath + '/core/core.z.js', BASE });
          return;
        }
        try {
          const r = await fetch(cifUrl, { cache: 'no-store' });
          if (!r.ok) throw new Error('CIF not found at ' + cifUrl);
        } catch (e) {
          showErr('CIF not found.', { cifUrl, hint: 'Put .cif under /public/assets/cifs and use ?cif=/assets/cifs/NAME.cif' });
          return;
        }

        try {
          const Info = {
            width: 600, height: 600, use: "HTML5", j2sPath,
            script: [
              `load "${cifUrl}";`,
              "set antialiasDisplay true;", "frank off;", "reset; zoom 110;",
              "select *; color cpk;", "spacefill 23%; wireframe 0.15;"
            ].join(' ')
          };
          const applet = Jmol.getApplet("jsmolApplet", Info);
          document.getElementById("applet").innerHTML = Jmol.getAppletHtml(applet);

          // controls
          const ctrls = document.getElementById('controls');
          ctrls.hidden = false;
          ctrls.addEventListener('click', e => {
            const b = e.target.closest('button[data-script]'); if (!b) return;
            Jmol.script(applet, b.getAttribute('data-script'));
          });

          elHint.hidden = true;
        } catch (e) {
          showErr('Failed to initialize JSmol.', { message: e && e.message, BASE, cifUrl, j2sPath });
        }
      })();
    </script>
  </body>
</html>
