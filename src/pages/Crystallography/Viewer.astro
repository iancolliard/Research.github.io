---
const BASE = import.meta.env.BASE_URL; // "/Research.github.io/" on GH Pages
const url  = new URL(Astro.request.url);
const title = url.searchParams.get('title') || 'CIF Viewer';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>{title}</title>
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <script src="https://chemapps.stolaf.edu/jmol/jsmol/JSmol.min.js"></script>
  <style>
    body{margin:16px;font-family:system-ui,-apple-system,"Segoe UI",Roboto,Arial}
    #viewer{width:min(92vw,820px);height:min(82vh,820px);border:1px solid #ddd}
    #log{margin:10px 0;padding:10px;border:1px solid #eee;border-radius:8px;background:#fafafa;max-width:820px}
    #log code{background:#f2f2f2;padding:0 4px;border-radius:4px}
    .bad{color:#b00}.ok{color:#056}
  </style>
</head>
<body>
  <h1 style="margin:0 0 8px">{title}</h1>
  <div id="log">Starting…</div>
  <div id="viewer"></div>

  <script>
    (async function () {
      const log = (msg, cls='')=>{
        const el = document.getElementById('log');
        el.innerHTML += '<div class="'+cls+'">'+msg+'</div>';
      };
      const params = new URLSearchParams(location.search);
      const cifParam = params.get('cif');
      if (!cifParam){
        log('No <code>?cif=</code> provided. Example: <code>?cif='+{BASE}+'assets/cifs/2055317.cif&amp;title=2055317</code>', 'bad');
        return;
      }

      // Resolve absolute URL (important on GH Pages)
      const cifURL = new URL(cifParam, location.href).href;
      log('Resolved CIF URL: <code>'+cifURL+'</code>');

      // 1) Init JSmol
      var Info = {
        use: "HTML5",
        j2sPath: "https://chemapps.stolaf.edu/jmol/jsmol/j2s",
        width: "100%",
        height: "100%",
        debug: false
      };
      var app = Jmol.getApplet("app", Info);
      document.getElementById("viewer").innerHTML = Jmol.getAppletHtml(app);

      // Show JSmol console in-page so we can see script errors
      Jmol.script(app, 'console on');

      // 2) Try direct URL load first
      log('Attempting direct load via <code>load "'+cifURL+'"</code>…');
      Jmol.script(app, 'load "'+cifURL+'"; background white; wireframe 0.15; spacefill off; set frank off;');

      // Give JSmol a moment; then check if anything is loaded
      const sleep = (ms)=>new Promise(r=>setTimeout(r,ms));
      await sleep(1200);
      var atomCount = Jmol.evaluate(app, 'atomCount');

      if (parseInt(atomCount,10) > 0) {
        log('Direct load OK. Atom count: <code>'+atomCount+'</code>', 'ok');
        Jmol.script(app, 'zoom 120; spin on;');
        return;
      } else {
        log('Direct load shows 0 atoms; falling back to inline load…');
      }

      // 3) Fallback: fetch text and use LOAD DATA
      try {
        const res = await fetch(cifURL, { cache: "no-store" });
        if (!res.ok) throw new Error('HTTP '+res.status+' '+res.statusText);
        const buf = await res.arrayBuffer();
        log('Downloaded bytes: <code>'+buf.byteLength+'</code>');

        // Try to decode as text (most .cif are text/plain on GH Pages)
        const text = new TextDecoder('utf-8', {fatal:false}).decode(new Uint8Array(buf));

        // Compose a SAFE LOAD DATA script (escape backslashes and quotes)
        const safe = text.replace(/\\/g,'\\\\').replace(/"/g,'\\"');
        const name = cifURL.split('/').pop() || 'model.cif';

        const script =
          'load DATA "model"\\n' + safe + '\\nEND "'+name+'"; ' +
          'background white; wireframe 0.15; spacefill off; set frank off; set zoomLarge true;';
        log('Issuing <code>load DATA</code> …');
        Jmol.script(app, script);

        await sleep(1200);
        atomCount = Jmol.evaluate(app, 'atomCount');
        if (parseInt(atomCount,10) > 0) {
          log('Inline load OK. Atom count: <code>'+atomCount+'</code>', 'ok');
          Jmol.script(app, 'zoom 120; spin on;');
        } else {
          log('Inline load still 0 atoms. Please check the CIF content/path.', 'bad');
        }
      } catch (e) {
        log('Fetch failed: <code>'+String(e)+'</code>', 'bad');
      }

      // Extra: print any last JSmol error line
      try {
        var lastMsg = Jmol.evaluate(app, 'message');
        if (lastMsg) log('JSmol message: <code>'+String(lastMsg)+'</code>');
      } catch (_) {}
    })();
  </script>
</body>
</html>
