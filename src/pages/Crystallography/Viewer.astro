---
/** If your site uses a layout, keep this import; otherwise remove Layout and its wrapper below. */
import Layout from '../../layouts/Page.astro';

const BASE = import.meta.env.BASE_URL || "/";
const page = { title: "Viewer" };
---

<Layout {page}>
  <head><meta name="robots" content="noindex" /></head>

  <section class="wrap">
    <header class="bar">
      <div class="ttl">
        <h1 class="h">Structure Viewer</h1>
        <p class="sub" id="viewer-title">Structure</p>
      </div>
      <div class="actions">
        <a id="download-cif" class="btn" href="#" download hidden>Download CIF</a>
        <a class="btn" href={`${BASE}Crystallography/`} aria-label="Back to Crystallography">Back</a>
      </div>
    </header>

    <div id="viewer" class="viewer" aria-label="3D structure viewer"></div>
    <p id="error" class="error" hidden></p>
  </section>

<script is:inline>
  (function () {
    // "/" locally; "/Research.github.io/" on GitHub Pages
    const BASE = {JSON.stringify(import.meta.env.BASE_URL || "/")};

    const $title  = document.getElementById('viewer-title');
    const $viewer = document.getElementById('viewer');
    const $error  = document.getElementById('error');
    const $dl     = document.getElementById('download-cif');

    // Helper to prefix your site base correctly
    const withBase = (p) => BASE + String(p).replace(/^\/+/, "");

    // Read ?cif= and ?title=
    const url = new URL(location.href);
    const rawCif   = url.searchParams.get("cif");
    const titleArg = url.searchParams.get("title") || "Structure";
    $title.textContent = titleArg;

    // Build a safe CIF URL
    const cifUrl = (() => {
      if (!rawCif) return "";
      if (rawCif.startsWith("http")) return rawCif;   // absolute URL
      if (rawCif.startsWith(BASE)) return rawCif;     // already base-prefixed
      return withBase(rawCif);                        // e.g. "/assets/cifs/name.cif"
    })();

    if (!cifUrl) {
      $error.hidden = false;
      $error.textContent = 'Missing CIF. Open with ?cif=/assets/cifs/NAME.cif&title=My+Sample';
      return;
    }

    // Show download button
    $dl.hidden = false;
    $dl.href = cifUrl;

    // Dynamically load JSmol from /public/jsmol (handles BASE automatically)
    const jsmolSrc = withBase("jsmol/JSmol.min.js");
    const s = document.createElement("script");
    s.src = jsmolSrc;
    s.onload = initJSmol;
    s.onerror = () => {
      $error.hidden = false;
      $error.textContent = 'Could not load JSmol at ' + jsmolSrc;
    };
    document.head.appendChild(s);

    function initJSmol() {
      if (!window.Jmol) {
        $error.hidden = false;
        $error.textContent = 'JSmol loaded, but window.Jmol is undefined.';
        return;
      }

      const Info = {
        width:  $viewer.clientWidth  || 600,
        height: $viewer.clientHeight || 600,
        use: "HTML5",
        j2sPath:  withBase("jsmol/j2s"),            // MUST exist
        serverURL: withBase("jsmol/php/jsmol.php"), // keep, even if unused
        script: `load ${cifUrl}; set frank OFF; set zoomlarge true; zoom 120;`
      };

      // Create applet object, then mount its HTML
      const applet = Jmol.getApplet("jsmolApplet0", Info);
      $viewer.innerHTML = Jmol.getAppletHtml(applet);

      // Responsive resizing
      window.addEventListener("resize", () => {
        const w = $viewer.clientWidth  || 600;
        const h = $viewer.clientHeight || 600;
        if (window.Jmol && Jmol.resizeApplet) Jmol.resizeApplet(applet, [w, h]);
      });
    }
  })();
</script>

</Layout>