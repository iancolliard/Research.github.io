---
/** If your site uses a layout, keep this import; otherwise remove Layout and its wrapper below. */
import Layout from '../../layouts/Page.astro';

const BASE = import.meta.env.BASE_URL || "/";
const page = { title: "Viewer" };
---

<Layout {page}>
  <head><meta name="robots" content="noindex" /></head>

  <section class="wrap">
    <header class="bar">
      <div class="ttl">
        <h1 class="h">Structure Viewer</h1>
        <p class="sub" id="viewer-title">Structure</p>
      </div>
      <div class="actions">
        <a id="download-cif" class="btn" href="#" download hidden>Download CIF</a>
        <a class="btn" href={`${BASE}Crystallography/`} aria-label="Back to Crystallography">Back</a>
      </div>
    </header>

    <div id="viewer" class="viewer" aria-label="3D structure viewer"></div>
    <p id="error" class="error" hidden></p>
  </section>

<script is:inline>
  (function () {
    // Injected at build: "/Research.github.io/" on GitHub Pages, "/" locally
    const BASE = {JSON.stringify(import.meta.env.BASE_URL || "/")};

    const $title = document.getElementById('viewer-title');
    const $viewer = document.getElementById('viewer');
    const $error  = document.getElementById('error');
    const $dl     = document.getElementById('download-cif');

    // Build a BASE-prefixed path (no leading slash required)
    const withBase = (p) => BASE + String(p).replace(/^\/+/, "");

    const url = new URL(location.href);
    const cifParam   = url.searchParams.get("cif");
    const titleParam = url.searchParams.get("title") || "Structure";
    $title.textContent = titleParam;

    const cifUrl = cifParam ? (cifParam.startsWith("http") ? cifParam : withBase(cifParam)) : "";

    if (!cifUrl) {
      $error.hidden = false;
      $error.textContent = 'Missing CIF. Open with ?cif=/assets/cifs/NAME.cif&title=My+Sample';
      return;
    }

    // Show download button
    $dl.hidden = false;
    $dl.href = cifUrl;

    // 1) Dynamically load JSmol from /public using BASE
    const jsmolSrc = withBase("jsmol/JSmol.min.js");
    const s = document.createElement("script");
    s.src = jsmolSrc;
    s.onload = initJSmol;
    s.onerror = () => {
      $error.hidden = false;
      $error.textContent = 'Could not load JSmol at ' + jsmolSrc;
    };
    document.head.appendChild(s);

    // 2) Initialize JSmol when script is ready
    function initJSmol() {
      if (!window.Jmol) {
        $error.hidden = false;
        $error.textContent = 'JSmol loaded, but window.Jmol is undefined.';
        return;
      }

      const Info = {
        width:  $viewer.clientWidth  || 600,
        height: $viewer.clientHeight || 600,
        use: "HTML5",
        j2sPath:  withBase("jsmol/j2s"),
        serverURL: withBase("jsmol/php/jsmol.php"),
        script: `load ${cifUrl}; set frank OFF; set zoomlarge true; zoom 120;`
      };

      $viewer.innerHTML = Jmol.getAppletHtml("jsmolApplet0", Info);

      // Handle resizing
      window.addEventListener("resize", () => {
        const w = $viewer.clientWidth  || 600;
        const h = $viewer.clientHeight || 600;
        if (window.Jmol && Jmol.resizeApplet) Jmol.resizeApplet("jsmolApplet0", [w, h]);
      });
    }
  })();
</script>



  <style>
    .wrap { display: grid; gap: 1rem; }
    .bar { display:flex; justify-content:space-between; align-items:center; gap:1rem; flex-wrap:wrap; }
    .h { margin:0; font-size: clamp(1.1rem, 2.2vw, 1.6rem); }
    .sub { margin:0; opacity:.7; }
    .actions { display:flex; gap:.5rem; }
    .btn { padding:.45rem .7rem; border:1px solid var(--accents-2, #ddd); border-radius:.5rem; text-decoration:none; }
    .viewer {
      width: min(1200px, 100%);
      height: min(75vh, 80rem);
      margin: 0 auto;
      border: 1px solid var(--accents-2, #e5e7eb);
      border-radius: .75rem;
    }
    .error { color:#b00020; }
  </style>
</Layout>