---
import { SEO } from '../../components/SEO.astro'; // if you have one; otherwise remove this line+component below
const base = import.meta.env.BASE_URL; // "/" locally, "/Research.github.io/" on GH Pages
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Crystal Viewer</title>

    <!-- Load JSmol from /public exactly; keep is:inline so Vite doesn’t bundle it -->
    <script src={`${base}assets/jsmol/JSmol.min.js`} is:inline></script>

    <style>
      #viewer-wrap { max-width: 900px; margin: 2rem auto; padding: 1rem; }
      #applet { width: 600px; height: 600px; margin: 0 auto; border: 1px solid #ddd; border-radius: 8px; }
      #controls { display:flex; gap:.5rem; justify-content:center; margin-top:1rem; flex-wrap:wrap; }
      button { padding:.5rem .8rem; border:1px solid #ccc; border-radius:8px; cursor:pointer; background:transparent; }
      .error { color:#c62828; text-align:center; font-weight:600; }
      .mono { font-family: ui-monospace, Menlo, Consolas, monospace; font-size:.9rem; background:rgba(127,127,127,.08); padding:.5rem .75rem; border-radius:.5rem; }
      h1, p { text-align:center; }
      details { margin-top:1rem; }
    </style>
  </head>
  <body>
    <main id="viewer-wrap">
      <h1 id="title">Crystal Viewer</h1>
      <div id="applet"></div>
      <div id="controls" hidden>
        <button data-script="spin on">Spin</button>
        <button data-script="spin off">Stop</button>
        <button data-script="zoom 120">Zoom 120%</button>
        <button data-script="zoom 100">Zoom 100%</button>
        <button data-script="spacefill on; wireframe off;">Spacefill</button>
        <button data-script="spacefill off; wireframe 0.15;">Wireframe</button>
        <button data-script="axes on">Axes</button>
        <button data-script="axes off">Axes off</button>
        <button data-script="set antialiasDisplay true">Antialias</button>
      </div>

      <!-- Correct usage hint (clickable) -->
      <p id="hint" class="mono">
        Open with
        <a id="ex" href="#">?cif=/assets/cifs/2055317.cif&title=2055317</a>
      </p>
      <p id="err" class="error" hidden></p>

      <details id="dbg" hidden>
        <summary>Debug</summary>
        <div id="dbgText" class="mono"></div>
      </details>
    </main>

<script is:inline>
  (function () {
    const BASE = {JSON.stringify(import.meta.env.BASE_URL || "/")};
    const withBase = (p) => BASE + String(p).replace(/^\/+/, "");

    const $title  = document.getElementById("viewer-title");
    const $viewer = document.getElementById("viewer");
    const $error  = document.getElementById("error");
    const $dl     = document.getElementById("download-cif");

    const url = new URL(location.href);
    const rawCif   = url.searchParams.get("cif");
    const titleArg = url.searchParams.get("title") || "Structure";
    $title.textContent = titleArg;

    const cifUrl = rawCif
      ? (rawCif.startsWith("http") || rawCif.startsWith(BASE) ? rawCif : withBase(rawCif))
      : "";

    if (!cifUrl) {
      $error.hidden = false;
      $error.textContent = "Missing CIF. Open with ?cif=/assets/cifs/NAME.cif&title=My+Sample";
      return;
    }

    // download link
    $dl.hidden = false;
    $dl.href = cifUrl;

    // absolute CIF URL for JSmol
    const fullCif = new URL(cifUrl, location.origin).href;

    // load JSmol from /public/assets/jsmol
    const jsmolSrc = withBase("assets/jsmol/JSmol.min.js");
    const s = document.createElement("script");
    s.src = jsmolSrc;
    s.onload = initJSmol;
    s.onerror = () => showErr("Could not load JSmol at " + jsmolSrc);
    document.head.appendChild(s);

    function showErr(msg) {
      $error.hidden = false;
      $error.textContent = msg;
      console.error("[JSmol viewer]", msg);
    }

    function initJSmol() {
      if (!window.Jmol) return showErr("JSmol loaded, but window.Jmol is undefined.");

      const Info = {
        width:  $viewer.clientWidth  || 600,
        height: $viewer.clientHeight || 600,
        use: "HTML5",
        j2sPath:  withBase("assets/jsmol/j2s"),
        serverURL: withBase("assets/jsmol/php/jsmol.php"),
        script: `load "${fullCif}"; set frank OFF; set zoomlarge true; zoom 120;`
      };

      const applet = Jmol.getApplet("jsmolApplet0", Info);
      $viewer.innerHTML = Jmol.getAppletHtml(applet);

      window.addEventListener("resize", () => {
        const w = $viewer.clientWidth  || 600;
        const h = $viewer.clientHeight || 600;
        if (Jmol.resizeApplet) Jmol.resizeApplet(applet, [w, h]);
      });
    }
  })();
</script>



  </body>
</html>
