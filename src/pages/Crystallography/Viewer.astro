---
const BASE = import.meta.env.BASE_URL;
const url  = new URL(Astro.request.url);
const title = url.searchParams.get('title') || 'CIF Viewer';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>{title}</title>
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <script src="https://3Dmol.org/build/3Dmol-min.js"></script>
  <style>
    body{margin:16px;font-family:system-ui,-apple-system,"Segoe UI",Roboto,Arial}
    #viewer{width:min(92vw,900px);height:min(82vh,820px);border:1px solid #ddd;border-radius:8px}
    #msg{margin:10px 0;max-width:900px}
    #msg code{background:#f3f3f3;padding:0 4px;border-radius:4px}
    .bad{color:#b00}.ok{color:#065}
  </style>
</head>
<body>
  <h1 style="margin:0 0 8px">{title}</h1>
  <div id="msg">starting…</div>
  <div id="viewer"></div>

  <script>
    (async function () {
      const $msg = document.getElementById('msg');
      const log = (t, cls='') => { $msg.innerHTML += `<div class="${cls}">${t}</div>`; };
      const showDummy = (v) => {
        v.addModel('C', 'smiles');
        v.setStyle({}, {stick:{}});
        v.zoomTo(); v.render();
      };

      const params = new URLSearchParams(location.search);
      const cifParam = params.get('cif');
      if (!cifParam) {
        log(`missing <code>?cif=</code>. try <code>?cif=${BASE}assets/cifs/NAME.cif&amp;title=My+Sample</code>`, 'bad');
        const v0 = $3Dmol.createViewer('viewer', { backgroundColor: 'white' }); showDummy(v0);
        return;
      }

      const cifURL = new URL(cifParam, location.href).href;
      log(`cif url: <code>${cifURL}</code>`);

      const v = $3Dmol.createViewer('viewer', { backgroundColor: 'white' });

      // Try 1: 3Dmol’s downloader
      try {
        await new Promise((resolve, reject) => {
          let settled = false;
          $3Dmol.download(cifURL, v, { format: 'cif' }, function () {
            settled = true;
            v.addUnitCell(); v.setStyle({}, {stick:{}}); v.zoomTo(); v.render();
            log('loaded via $3Dmol.download', 'ok'); resolve();
          });
          setTimeout(()=>{ if(!settled) reject(new Error('download timeout')); }, 2500);
        });
        return;
      } catch (e) {
        log('download path failed ('+String(e)+') → trying fetch/addModel…');
      }

      // Try 2: Fetch + addModel
      try {
        const res = await fetch(cifURL, { cache: 'no-store' });
        log(`HTTP status: <code>${res.status}</code>`);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const text = await res.text();
        log(`bytes: <code>${text.length}</code>`);
        // quick sniff: if it’s an HTML 404 page, bail
        if (text.startsWith('<!doctype') || text.startsWith('<html')) throw new Error('Got HTML (likely 404), not CIF');

        const m = v.addModel(text, 'cif');
        v.addUnitCell(m);
        v.setStyle({}, {stick:{}});
        v.zoomTo(); v.render();
        log('loaded via fetch/addModel', 'ok');
      } catch (e) {
        log('failed to load cif: <code>'+String(e)+'</code>', 'bad');
        showDummy(v);
      }
    })();
  </script>
</body>
</html>
